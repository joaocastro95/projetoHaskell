{
  // Ambiente do GitHub Codespaces: GHC 9.10 + cabal (imagem oficial do Haskell) e Node 20.
  "name": "PerdaZero (Haskell + Next.js)",
  // A imagem é montada pelo Dockerfile ao lado (haskell:9.10 + Node 20).
  "build": { "dockerfile": "Dockerfile" },

  // Na criação do Codespace: libera o Git na pasta (o terminal roda como root, mas a pasta é de
  // outro usuário) e baixa/compila as dependências (demora uns 10-15 min na 1ª vez).
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && cabal update && cabal build && npm install",

  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": { "label": "Site (Next.js)", "onAutoForward": "openBrowser" },
    "8081": { "label": "API Haskell", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["justusadam.language-haskell"]
    }
  }
}
