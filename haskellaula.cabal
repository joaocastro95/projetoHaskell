cabal-version:      3.0
name:               haskellaula
version:            0.2.0.0
synopsis:           PerdaZero: controle de validade e desperdício (back-end Haskell + Servant)
license:            BSD-3-Clause
license-file:       LICENSE
author:             Eu
maintainer:         joaov.castro95@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable haskellaula
    import:           warnings
    main-is:          Main.hs
    other-modules:    Tipos, Banco, Regras, Auth
    -- -threaded é obrigatório no Windows: sem ele, o Warp trava esperando conexões
    -- e o navegador (que mantém conexões abertas) fica sem resposta.
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base,
                      servant,
                      servant-server,
                      warp,
                      aeson,
                      text,
                      time,
                      sqlite-simple,
                      bytestring,
                      containers,
                      cryptohash-sha256,
                      entropy,
                      base16-bytestring
    hs-source-dirs:   app
    default-language: Haskell2010
