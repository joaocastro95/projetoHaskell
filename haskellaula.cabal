cabal-version:      3.0
name:               haskellaula
version:            0.2.0.0
synopsis:           PerdaZero: controle de validade e desperdício (back-end Haskell + Servant)
license:            BSD-3-Clause
license-file:       LICENSE
author:             Eu
maintainer:         joaov.castro95@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

-- Biblioteca: todo o back-end (rotas, handlers, regras, banco).
-- Fica separada do executável para os testes poderem usar os módulos.
library
    import:           warnings
    exposed-modules:  Api, App, Handlers, Tipos, Banco, Regras, Auth
    build-depends:    base,
                      servant,
                      servant-server,
                      aeson,
                      text,
                      time,
                      sqlite-simple,
                      bytestring,
                      containers,
                      mtl,
                      cryptohash-sha256,
                      entropy,
                      base16-bytestring
    hs-source-dirs:   src
    default-language: Haskell2010

-- Executável: só abre o banco e sobe o servidor (app/Main.hs).
executable haskellaula
    import:           warnings
    main-is:          Main.hs
    -- -threaded é obrigatório no Windows: sem ele, o Warp trava esperando conexões
    -- e o navegador (que mantém conexões abertas) fica sem resposta.
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base,
                      haskellaula,
                      warp
    hs-source-dirs:   app
    default-language: Haskell2010

-- Testes das regras de negócio (cabal test).
test-suite testes
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    RegrasSpec
    build-depends:    base,
                      haskellaula,
                      hspec,
                      text,
                      time
    hs-source-dirs:   test
    default-language: Haskell2010
